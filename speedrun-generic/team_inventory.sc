// ============================================================================
// 团队背包系统 (Team Inventory System)
// ============================================================================
//
// 功能概述：
// 提供一个共享的54格背包，所有玩家可以访问
// 同时只能有一个玩家使用，防止物品冲突
//
// 特性：
// - 54个物品槽位（6行9列）
// - 互斥访问（同时只能一人使用）
// - 自动保存和加载
// - 支持所有物品类型和NBT数据
// ============================================================================

// ----------------------------------------------------------------------------
// 配置和命令定义
// ----------------------------------------------------------------------------
__config()->{
    'strict'->true,
    'scope'->'global',
    'command_permission'->'all',
    'commands'->{
        '' -> 'open_inventory'  // /team_inventory 打开共享背包
    }
};

// ----------------------------------------------------------------------------
// 全局变量
// ----------------------------------------------------------------------------

// 背包物品存储
// 格式: slot_index -> [item_name, count, nbt]
global_inventory={};

// 当前正在使用背包的玩家
global_current_user=null;

// ----------------------------------------------------------------------------
// 保存背包内容到全局变量
// 参数: screen - 背包界面对象
// ----------------------------------------------------------------------------
store_inventory(screen)->(
    global_inventory={};
    // 遍历所有54个槽位
    for(range(54),
        item=inventory_get(screen, _);
        if (item == null,
            continue();  // 跳过空槽位
        );
        global_inventory:_=item;  // 保存物品数据
    );
    save_data();  // 持久化到文件
);

// ----------------------------------------------------------------------------
// 从全局变量加载背包内容
// 参数: screen - 背包界面对象
// ----------------------------------------------------------------------------
load_inventory(screen)->(
    // 遍历所有54个槽位
    for(range(54),
        item=global_inventory:_;
        if (item == null,
            continue();  // 跳过空槽位
        );
        // 设置物品：inventory_set(screen, slot, count, item_name, nbt)
        inventory_set(screen, _, item:1, item:0, item:2);
    );
);

// ----------------------------------------------------------------------------
// 保存数据到文件
// 将物品数据转换为可序列化的格式并保存
// ----------------------------------------------------------------------------
save_data()->(
    clean_inventory={};
    // 转换物品数据为可序列化格式
    for(global_inventory,
        item=global_inventory:_;
        clean_item={
            'item'->item:0,      // 物品ID
            'count'->item:1,     // 数量
            'nbt'->str(item:2)   // NBT数据（转为字符串）
        };
        clean_inventory:_=clean_item;
    );
    // 写入JSON文件
    write_file('global', 'json', clean_inventory);
);

// ----------------------------------------------------------------------------
// 从文件加载数据
// 读取并解析保存的物品数据
// ----------------------------------------------------------------------------
load_data()->(
    clean_inventory=read_file('global', 'json');
    // 解析物品数据
    for(clean_inventory,
        index=number(_);
        item=clean_inventory:_;
        item_nbt = nbt(item:'nbt');
        // 处理NBT数据（可能为null）
        if (item_nbt == null || item_nbt == '"null"',
            global_inventory:index=[item:'item', item:'count',null];
        ,
            global_inventory:index=[item:'item', item:'count', nbt(item:'nbt')];
        );
    );
);

// ----------------------------------------------------------------------------
// 打开共享背包
// 创建背包界面并加载内容
// ----------------------------------------------------------------------------
open_inventory()->(
    // 检查是否有其他玩家正在使用
    if(global_current_user != null,
        print(player(), format('l 有人在使用共享背包'));
        return();
    );

    // 创建6行9列的背包界面
    screen=create_screen(player(),'generic_9x6','共享背包', _(screen, player, action, data) ->(
        // 关闭时的回调函数
        if (action == 'close',
            global_current_user=null;      // 释放使用权
            store_inventory(screen);        // 保存背包内容
        );
    ));

    // 加载背包内容
    load_inventory(screen);
    // 标记当前用户
    global_current_user=player();
);

// ----------------------------------------------------------------------------
// 服务器启动时加载数据
// ----------------------------------------------------------------------------
__on_start()->(
    load_data();
);

// ----------------------------------------------------------------------------
// 玩家连接时显示提示
// ----------------------------------------------------------------------------
__on_player_connects(player)->(
    print(player, format('l 使用/team_inventory打开共享背包'));
);
